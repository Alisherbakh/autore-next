import React from 'react';
import { Stack } from '@mui/material';
import { useRouter } from 'next/router';
import { useTranslation } from 'next-i18next';
import { CarType } from '../../enums/car.enum';
import SectionHead from './SectionHead';
import { formatEnum } from '../../utils';

// "Pick a body style" bo'limi: kuzov turi bosilsa /car sahifasi shu tur filtri bilan ochiladi
const CarTypes = () => {
	const router = useRouter();
	const { t } = useTranslation('common');
	const types = Object.values(CarType);

	const pushTypeHandler = async (type: CarType) => {
		const input = { page: 1, limit: 9, sort: 'createdAt', direction: 'DESC', search: { typeList: [type] } };
		await router.push(`/car?input=${JSON.stringify(input)}`, `/car?input=${JSON.stringify(input)}`);
	};

	return (
		<Stack component={'section'} className={'car-types hp-section'}>
			<Stack className={'container'}>
				<SectionHead title={t('Pick a body style')} />
				{/* bento: birinchi ikki tur (sedan, SUV) katta plitka */}
				<div className={'type-grid'}>
					{types.map((type: CarType, index: number) => (
						<button
							type={'button'}
							className={`type-tile ${index < 2 ? 'is-large' : ''}`}
							key={type}
							onClick={() => pushTypeHandler(type)}
						>
							{/* haqiqiy mashina rasmi: public/img/types/<tur>.jpg (mualliflar — public/img/fiber/CREDITS.md) */}
							<img src={`/img/types/${type.toLowerCase()}.jpg`} alt={''} loading={'lazy'} />
							<span className={'type-name'}>
								<strong>{formatEnum(type)}</strong>
								<span>
									{t('Browse')}
									<svg viewBox="0 0 16 16" width={14} height={14} aria-hidden="true">
										<path d="M3 8h9M8.5 4.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" />
									</svg>
								</span>
							</span>
						</button>
					))}
				</div>
			</Stack>
		</Stack>
	);
};

export default CarTypes;
