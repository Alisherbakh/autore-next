/**
 * BOSH SAHIFA — "Showcase" dizayn qatlami (Hyundai hero + Kia kartalar uslubi).
 * main.scss oxirida import qilinadi, shuning uchun oldingi homepage.scss / v01 stillari ustidan yoziladi.
 * Faqat #pc-wrap (desktop). Mobil bosh sahifa o'zgarmagan.
 */
$hs-ease: cubic-bezier(0.23, 1, 0.32, 1);
$hs-horizon: 560px; // devor va pol chegarasi (section tepasidan)
$hs-graphite: #14171c;

#pc-wrap {
	/* ---------- HERO: beton studiya + mashina slayderi ---------- */
	.header-main.hero-search.hero-showcase-wrap {
		position: relative;
		z-index: 3; // qidiruv dropdownlari keyingi bo'limlar ustida ochilishi uchun
		height: auto;
		padding: 112px 0 48px; // shaffof navbar ostidan boshlanadi
		box-sizing: border-box;
		background: linear-gradient(
			180deg,
			#8c8780 0px,
			#7a756f $hs-horizon - 1px,
			#57534e $hs-horizon,
			#3f3c38 100%
		);

		> .container.hs-search {
			margin-top: 24px;
			width: min(1300px, calc(100% - 48px));
		}
	}

	.hero-showcase {
		// sahna (devor chiziqlari, yorug'lik) butun section kengligida
		.hs-stage {
			position: absolute;
			inset: 0;
			overflow: hidden;
			pointer-events: none;
		}
		.hs-wall {
			position: absolute;
			left: 0;
			right: 0;
			top: 0;
			height: $hs-horizon;
			background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.1) 0 2px, transparent 2px 220px),
				repeating-linear-gradient(180deg, rgba(0, 0, 0, 0.07) 0 2px, transparent 2px 150px);
		}
		.hs-beam {
			position: absolute;
			inset: 0;
			background: linear-gradient(118deg, transparent 44%, rgba(255, 246, 230, 0.22) 52%, rgba(255, 246, 230, 0.1) 60%, transparent 68%),
				linear-gradient(90deg, rgba(20, 18, 16, 0.62) 0%, rgba(20, 18, 16, 0.22) 38%, rgba(20, 18, 16, 0) 60%);
		}
		.hs-floor {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 220px;
			background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.35));
		}
		.hs-shadow {
			position: absolute;
			right: 10%;
			width: 50%;
			top: $hs-horizon - 20px;
			height: 64px;
			border-radius: 50%;
			background: radial-gradient(closest-side, rgba(0, 0, 0, 0.5), transparent);
		}

		.hs-inner {
			position: relative;
			width: min(1300px, calc(100% - 48px));
			height: 470px;
			margin: 0 auto;
		}

		/* matn (chap) — hamma slaydlar ustma-ust, faqat faoli ko'rinadi */
		.hs-copy {
			position: absolute;
			left: 0;
			top: 24px;
			width: min(500px, 42%);
			height: 100%;
			z-index: 2;
		}
		.hs-text {
			position: absolute;
			inset: 0 0 auto 0;
			opacity: 0;
			transform: translateY(16px);
			pointer-events: none;
			transition: opacity 500ms ease, transform 700ms $hs-ease;
			&.is-active {
				opacity: 1;
				transform: none;
				pointer-events: auto;
			}
			h1 {
				margin: 18px 0 0;
				color: #ffffff;
				font-family: $font;
				font-size: clamp(44px, 3.6vw + 12px, 76px);
				font-weight: 800;
				line-height: 0.98;
				letter-spacing: -0.035em;
			}
			p {
				margin: 16px 0 0;
				max-width: 36ch;
				color: rgba(255, 255, 255, 0.85);
				font-family: $font;
				font-size: 18px;
				line-height: 1.5;
			}
		}
		.hs-tag {
			display: inline-flex;
			align-items: center;
			height: 30px;
			padding: 0 12px;
			border-radius: 15px;
			background: rgba(20, 23, 28, 0.45);
			color: #ffffff;
			font-family: $font;
			font-size: 12px;
			font-weight: 700;
			letter-spacing: 0.08em;
		}
		.hs-actions {
			margin-top: 28px;
			display: flex;
			flex-wrap: wrap;
			gap: 12px;
		}
		.hs-btn {
			height: 52px;
			padding: 0 28px;
			box-sizing: border-box;
			display: inline-flex;
			align-items: center;
			border-radius: 26px;
			font-family: $font;
			font-size: 15px;
			font-weight: 700;
			transition: transform 160ms $hs-ease, background-color 150ms ease, box-shadow 160ms ease;
			&:active {
				transform: scale(0.97);
			}
			&:focus-visible {
				outline: 2px solid #ffffff;
				outline-offset: 3px;
			}
			&.is-light {
				background: #ffffff;
				color: $hs-graphite;
				&:active {
					background: #d9dbe0;
				}
			}
			&.is-primary {
				background: $c-primary;
				color: #ffffff;
			}
		}

		/* mashina (o'ng) — fonsiz PNG/WebP, studiya poliga "qo'yilgan" */
		.hs-cars {
			position: absolute;
			right: -2%;
			bottom: 0;
			width: min(860px, 66%);
			aspect-ratio: 1000 / 442;
		}
		.hs-car {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: contain;
			opacity: 0;
			transform: translateX(48px) scale(0.97);
			transition: opacity 700ms ease, transform 1000ms $hs-ease;
			&.is-active {
				opacity: 1;
				transform: none;
			}
		}

		/* boshqaruv: hisoblagich, nuqtalar, pauza | oldingi / keyingi */
		.hs-controls {
			position: relative;
			z-index: 2;
			width: min(1300px, calc(100% - 48px));
			margin: 8px auto 0;
			display: flex;
			align-items: center;
			gap: 14px;
		}
		.hs-count {
			min-width: 64px;
			color: rgba(255, 255, 255, 0.85);
			font-family: $font;
			font-size: 13px;
			font-weight: 700;
			font-variant-numeric: tabular-nums;
		}
		.hs-dots {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.hs-dot {
			width: 8px;
			height: 8px;
			border: 0;
			border-radius: 4px;
			background: rgba(255, 255, 255, 0.4);
			cursor: pointer;
			transition: width 300ms $hs-ease, background-color 200ms ease;
			&.is-active {
				width: 32px;
				background: #ffffff;
			}
		}
		.hs-round {
			width: 44px;
			height: 44px;
			border-radius: 22px;
			border: 1px solid rgba(255, 255, 255, 0.4);
			background: transparent;
			color: #ffffff;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
		}
		.hs-arrows {
			margin-left: auto;
			display: flex;
			align-items: center;
			gap: 10px;
		}
		.hs-next {
			height: 44px;
			padding: 0 18px 0 20px;
			border-radius: 22px;
			border: 1px solid rgba(255, 255, 255, 0.4);
			background: transparent;
			color: #ffffff;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-family: $font;
			font-size: 14px;
			font-weight: 600;
			cursor: pointer;
		}
		button:focus-visible {
			outline: 2px solid #ffffff;
			outline-offset: 3px;
		}

		@media (hover: hover) and (pointer: fine) {
			.hs-round:hover,
			.hs-next:hover {
				background: rgba(255, 255, 255, 0.12);
			}
			.hs-btn.is-primary:hover {
				background: $c-primary-dark;
			}
			// "Find a dealer" (oq tugma): hover'da biroz kulrang tus
			.hs-btn.is-light:hover {
				background: #e8e9ec;
			}
			// ikkala tugma: hover'da biroz yuqoriga ko'tariladi, bosilganda pastga "botadi"
			.hs-btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 22px -10px rgba(0, 0, 0, 0.45);
			}
			.hs-btn:active {
				transform: translateY(0) scale(0.97);
				box-shadow: none;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.hs-text,
			.hs-car,
			.hs-dot {
				transition: none;
			}
			.hs-btn:hover,
			.hs-btn:active {
				transform: none;
			}
		}
		// tor desktop oyna: matn tepada, mashina ostida
		@media (max-width: 1024px) {
			.hs-inner {
				height: 560px;
			}
			.hs-copy {
				width: 100%;
				top: 0;
			}
			.hs-cars {
				right: 0;
				width: 88%;
			}
		}
	}

	/* ---------- TEZKOR MENYU (QuickMenu) ---------- */
	.home-page .quick-menu {
		padding: 40px 0 8px;
		background: $c-bg;
		.qm-list {
			margin: 0;
			padding: 0;
			list-style: none;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
			gap: 8px;
		}
		.qm-item {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 12px;
			padding: 16px 8px;
			border-radius: $r-md;
			color: $c-text;
			white-space: normal;
			text-align: center;
			&:focus-visible {
				outline: 2px solid $c-primary;
				outline-offset: 2px;
			}
		}
		.qm-icon {
			width: 64px;
			height: 64px;
			border-radius: 20px;
			border: 1px solid $c-line;
			background: #ffffff;
			display: flex;
			align-items: center;
			justify-content: center;
			color: $c-text;
			transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
		}
		.qm-label {
			font-family: $font;
			font-size: 14px;
			font-weight: 600;
		}
		@media (hover: hover) and (pointer: fine) {
			.qm-item:hover .qm-icon {
				background: $c-primary;
				border-color: $c-primary;
				color: #ffffff;
			}
		}
	}

	/* ---------- SELL PROMO (oldingi video reklama o'rnida) ---------- */
	.home-page .sell-promo {
		background: $c-bg;
		.sp-card {
			padding: clamp(32px, 4vw, 64px);
			border-radius: 28px;
			background: $hs-graphite;
			color: #ffffff;
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 48px;
		}
		.sp-copy {
			flex: 1 1 380px;
			h2 {
				margin: 12px 0 0;
				font-family: $font;
				font-size: clamp(32px, 2.4vw + 12px, 52px);
				font-weight: 800;
				line-height: 1.02;
				letter-spacing: -0.03em;
				color: #ffffff;
			}
			p {
				margin: 16px 0 0;
				max-width: 46ch;
				color: rgba(255, 255, 255, 0.75);
				font-family: $font;
				font-size: 17px;
				line-height: 1.6;
			}
		}
		.sp-tag {
			color: #9db6ff;
			font-family: $font;
			font-size: 13px;
			font-weight: 700;
			letter-spacing: 0.08em;
		}
		.sp-btn {
			margin-top: 28px;
			height: 52px;
			padding: 0 28px;
			border-radius: 26px;
			background: $c-primary;
			color: #ffffff;
			display: inline-flex;
			align-items: center;
			font-family: $font;
			font-weight: 700;
		}
		.sp-steps {
			flex: 1 1 380px;
			margin: 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 12px;
			li {
				// raqam ustuni qat'iy 56px — 01 / 02 / 03 yonidagi matnlar bir chiziqda turadi
				display: grid;
				grid-template-columns: 56px minmax(0, 1fr);
				align-items: center;
				padding: 20px 24px;
				border-radius: 18px;
				background: rgba(255, 255, 255, 0.06);
			}
			strong {
				display: block;
				font-family: $font;
				font-size: 17px;
				font-weight: 700;
			}
			span:not(.sp-num) {
				display: block;
				margin-top: 2px;
				color: rgba(255, 255, 255, 0.65);
				font-family: $font;
				font-size: 14px;
			}
		}
		.sp-num {
			color: #9db6ff;
			font-family: $font;
			font-size: 28px;
			font-weight: 800;
		}
	}

	/* ---------- TOP DEALERS: katta rasmli karta ---------- */
	.home-page .top-dealers {
		.top-dealers-slide {
			width: calc((100% - 3 * 29px) / 4);
		}
		.hp-dealer.is-photo {
			padding: 0;
			overflow: hidden;
			align-items: stretch;
			text-align: left;
			background: #ffffff;
			border: 1px solid $c-line;
			transition: transform 240ms $hs-ease, box-shadow 240ms $hs-ease;
			.hp-dealer-photo {
				aspect-ratio: 1 / 1;
				overflow: hidden;
				background: $c-surface-2;
			}
			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				box-shadow: none;
				transition: transform 500ms $hs-ease;
			}
			.hp-dealer-body {
				padding: 16px 18px 20px;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 8px;
			}
			strong {
				margin-top: 0;
				font-size: 18px;
			}
			.hp-dealer-type {
				margin-top: 0;
			}
			@media (hover: hover) and (pointer: fine) {
				&:hover {
					transform: translateY(-4px);
					box-shadow: 0 18px 40px -18px rgba(20, 23, 28, 0.35);
					img {
						transform: scale(1.04);
					}
				}
			}
		}
		@media (max-width: 1024px) {
			.top-dealers-slide {
				width: calc((100% - 2 * 29px) / 3);
			}
		}
	}
}

/* ---------- DEALER KARTASI (bosh sahifa Top Dealers + /dealer sahifasi — bitta dizayn) ---------- */
#pc-wrap .dc-card {
	height: 100%;
	box-sizing: border-box;
	overflow: hidden;
	border: 1px solid $c-line;
	border-radius: $r-md;
	background: #ffffff;
	transition: transform 240ms $hs-ease, box-shadow 240ms $hs-ease;

	.dc-photo {
		position: relative;
		display: block;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		background: linear-gradient(160deg, #e8eeff, #c9d6ff);
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 500ms $hs-ease;
		}
	}
	.dc-initials {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: $c-primary;
		font-family: $font;
		font-size: 56px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.dc-cars-badge {
		position: absolute;
		left: 12px;
		bottom: 12px;
		height: 28px;
		padding: 0 12px;
		border-radius: 14px;
		background: rgba(20, 23, 28, 0.78);
		color: #ffffff;
		display: inline-flex;
		align-items: center;
		font-family: $font;
		font-size: 12px;
		font-weight: 700;
	}

	.dc-body {
		flex: 1; // karta balandligini to'ldiradi — stats va tugma pastga tushadi
		padding: 16px 18px 18px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.dc-name {
		overflow: hidden;
		color: $c-text;
		font-family: $font;
		font-size: 18px;
		font-weight: 700;
		line-height: 1.3;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.dc-meta {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.dc-badge {
		flex-shrink: 0;
		height: 22px;
		padding: 0 9px;
		border-radius: 11px;
		background: $hs-graphite;
		color: #ffffff;
		display: inline-flex;
		align-items: center;
		font-family: $font;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.dc-city {
		min-width: 0;
		overflow: hidden;
		color: #5a616b;
		font-family: $font;
		font-size: 13px;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.dc-desc {
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		color: #5a616b;
		font-family: $font;
		font-size: 14px;
		line-height: 1.45;
		min-height: calc(2 * 1.45em); // doim 2 qator joy
		&.is-empty {
			color: #9aa0a8;
			font-style: italic;
		}
	}
	.dc-stats {
		margin-top: auto; // pastga yopishadi — hamma kartada bir xil balandlikda
		padding-top: 12px;
		border-top: 1px solid $c-line;
		display: flex;
		align-items: center;
		gap: 16px;
		color: #3b414a;
		font-family: $font;
		font-size: 14px;
		font-weight: 600;
		> span {
			display: inline-flex;
			align-items: center;
			gap: 4px;
		}
		svg {
			font-size: 18px;
			color: #8a9099;
		}
		.dc-like .MuiIconButton-root {
			margin: -6px 0 -6px -6px;
		}
	}
	.dc-btn {
		margin-top: 4px;
		height: 44px;
		border-radius: 12px;
		background: $hs-graphite;
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: $font;
		font-size: 14px;
		font-weight: 700;
		transition: background-color 160ms ease, transform 120ms $hs-ease;
		&:active {
			background: #000000;
			transform: scale(0.97); // bosilganda biroz "botib" ketadi
		}
		&:focus-visible {
			outline: 2px solid $c-primary;
			outline-offset: 2px;
		}
	}
	a:focus-visible {
		outline: 2px solid $c-primary;
		outline-offset: 2px;
	}

	@media (hover: hover) and (pointer: fine) {
		&:hover {
			transform: translateY(-4px);
			box-shadow: 0 18px 40px -18px rgba(20, 23, 28, 0.35);
			.dc-photo img {
				transform: scale(1.04);
			}
		}
		.dc-btn:hover {
			background: #2c313a; // ko'k emas — biroz ochroq grafit
		}
		.dc-btn:active {
			background: #000000;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		&,
		.dc-photo img,
		.dc-btn {
			transition: none;
		}
		.dc-btn:active {
			transform: none;
		}
	}
}

/* ---------- PAY YOUR WAY ("Top cars" o'rnida: kredit / barter mashinalari) ---------- */
#pc-wrap .home-page .pay-way {
	background: $c-bg;
	.pw-card {
		padding: clamp(28px, 4vw, 48px);
		border-radius: 28px;
		background: $hs-graphite;
		color: #ffffff;
	}
	.pw-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		h2 {
			margin: 0;
			color: #ffffff;
			font-family: $font;
			font-size: clamp(28px, 1.6vw + 18px, 40px);
			font-weight: 800;
			letter-spacing: -0.03em;
		}
		p {
			margin: 8px 0 0;
			color: rgba(255, 255, 255, 0.7);
			font-family: $font;
			font-size: 16px;
		}
	}
	.pw-tabs {
		padding: 4px;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.08);
		display: flex;
		gap: 4px;
		button {
			height: 42px;
			padding: 0 20px;
			border: 0;
			border-radius: 21px;
			background: transparent;
			color: rgba(255, 255, 255, 0.75);
			font-family: $font;
			font-size: 14px;
			font-weight: 700;
			cursor: pointer;
			transition: background-color 160ms ease, color 160ms ease;
			&.is-active {
				background: #ffffff;
				color: $hs-graphite;
			}
			&:focus-visible {
				outline: 2px solid #ffffff;
				outline-offset: 2px;
			}
		}
	}
	.pw-points {
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		li {
			height: 34px;
			padding: 0 14px;
			border-radius: 17px;
			background: rgba(255, 255, 255, 0.08);
			color: rgba(255, 255, 255, 0.85);
			display: flex;
			align-items: center;
			gap: 8px;
			font-family: $font;
			font-size: 13px;
			font-weight: 600;
			span {
				color: #8db6ff;
				font-weight: 800;
			}
		}
	}
	.pw-grid {
		margin-top: 28px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 16px;
	}
	.pw-empty {
		grid-column: 1 / -1;
		padding: 40px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.7);
		text-align: center;
		font-family: $font;
	}
	.pw-car {
		overflow: hidden;
		border-radius: 18px;
		background: #ffffff;
		color: $c-text;
		display: flex;
		flex-direction: column;
		white-space: normal;
		transition: transform 240ms $hs-ease, box-shadow 240ms ease;
		&:focus-visible {
			outline: 2px solid #ffffff;
			outline-offset: 3px;
		}
	}
	.pw-img {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #eceef1;
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 500ms $hs-ease;
		}
	}
	.pw-badge {
		position: absolute;
		left: 12px;
		top: 12px;
		height: 26px;
		padding: 0 10px;
		border-radius: 13px;
		background: $c-primary;
		color: #ffffff;
		display: flex;
		align-items: center;
		font-family: $font;
		font-size: 12px;
		font-weight: 700;
		&.is-barter {
			background: #0f6b3e;
		}
	}
	.pw-body {
		padding: 16px 18px 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: $font;
		strong {
			overflow: hidden;
			font-size: 16px;
			font-weight: 700;
			white-space: nowrap;
			text-overflow: ellipsis;
		}
		span {
			color: #6b7079;
			font-size: 13px;
		}
		b {
			margin-top: 8px;
			padding-top: 12px;
			border-top: 1px solid #efede8;
			font-size: 21px;
			font-weight: 800;
			letter-spacing: -0.02em;
		}
	}
	.pw-more {
		margin-top: 28px;
		display: flex;
		justify-content: center;
	}
	.pw-more-btn {
		height: 50px;
		padding: 0 26px;
		border-radius: 25px;
		background: #ffffff;
		color: $hs-graphite;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: $font;
		font-weight: 700;
		transition: transform 160ms $hs-ease, box-shadow 160ms ease, background-color 160ms ease;
		&:active {
			transform: scale(0.97);
		}
	}
	@media (hover: hover) and (pointer: fine) {
		.pw-car:hover {
			transform: translateY(-4px);
			box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
			img {
				transform: scale(1.04);
			}
		}
		.pw-tabs button:not(.is-active):hover {
			color: #ffffff;
		}
		.pw-more-btn:hover {
			transform: translateY(-2px);
			background: #e8e9ec;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pw-car,
		.pw-img img,
		.pw-more-btn {
			transition: none;
		}
		.pw-car:hover,
		.pw-more-btn:hover {
			transform: none;
		}
	}
}

/* ---------- PICK A BODY STYLE: studiya mashinalari (6 ta plitka) ---------- */
#pc-wrap .home-page .car-types {
	.bs-head {
		margin-bottom: 32px;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		h2 {
			margin: 0;
			color: $c-text;
			font-family: $font;
			font-size: clamp(28px, 1.6vw + 18px, 40px);
			font-weight: 800;
			letter-spacing: -0.03em;
		}
		p {
			margin: 8px 0 0;
			color: #6b7079;
			font-family: $font;
			font-size: 16px;
		}
	}
	.bs-all {
		color: $c-primary-dark;
		font-family: $font;
		font-size: 14px;
		font-weight: 700;
	}
	.bs-grid {
		display: grid;
		// 8 ta plitka: keng ekranda 4 tadan 2 qator
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		@media (max-width: 1100px) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.bs-tile {
		position: relative;
		aspect-ratio: 16 / 11;
		padding: 22px 24px 20px;
		box-sizing: border-box;
		overflow: hidden;
		border: 1px solid #e8e6e0;
		border-radius: 22px;
		background: linear-gradient(180deg, #f3f2ee 0%, #ffffff 70%);
		color: $c-text;
		display: flex;
		flex-direction: column;
		text-align: left;
		cursor: pointer;
		transition: background-color 300ms ease, box-shadow 300ms ease, transform 300ms $hs-ease;
		&:focus-visible {
			outline: 2px solid $c-primary;
			outline-offset: 3px;
		}
	}
	.bs-text {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-family: $font;
		strong {
			font-size: 22px;
			font-weight: 800;
			letter-spacing: -0.02em;
		}
		span {
			color: #6b7079;
			font-size: 13px;
			font-weight: 600;
		}
	}
	.bs-stage {
		position: relative;
		flex: 1;
		min-height: 0;
		img {
			position: absolute;
			left: 4%;
			bottom: 0;
			width: 92%;
			height: auto;
			display: block;
			transition: transform 600ms $hs-ease;
		}
	}
	.bs-shadow {
		position: absolute;
		left: 12%;
		right: 12%;
		bottom: 6%;
		height: 18%;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgba(20, 23, 28, 0.28), transparent);
	}
	.bs-go {
		position: absolute;
		right: 18px;
		bottom: 18px;
		z-index: 2;
		height: 36px;
		padding: 0 14px;
		border: 1px solid $c-line;
		border-radius: 18px;
		background: #ffffff;
		color: $c-text;
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: $font;
		font-size: 13px;
		font-weight: 700;
		transition: background-color 200ms ease, color 200ms ease, transform 200ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.bs-tile:hover {
			background: #eceae4;
			box-shadow: 0 20px 40px -24px rgba(20, 23, 28, 0.35);
			transform: translateY(-3px);
			img {
				transform: translateX(10px) scale(1.03);
			}
			.bs-go {
				background: $hs-graphite;
				border-color: $hs-graphite;
				color: #ffffff;
				transform: translateX(2px);
			}
		}
	}
	.bs-tile:active {
		transform: scale(0.98);
	}
	@media (prefers-reduced-motion: reduce) {
		.bs-tile,
		.bs-stage img,
		.bs-go {
			transition: none;
		}
		.bs-tile:hover,
		.bs-tile:hover img,
		.bs-tile:active {
			transform: none;
		}
	}
}
