import React from 'react';
import Link from 'next/link';
import { Stack } from '@mui/material';
import HeaderFilter from './HeaderFilter';
import { useTranslation } from 'next-i18next';
import FiberContainer from '../common/FiberContainer';

// Bosh sahifaning yuqori qismi: sarlavha + ikki CTA, uning ostida 3D galereya (hashamatli va mashhur mashinalar)
// va eng pastda mashina qidiruvi (HeaderFilter — mantiq o'zgarmagan)
const HeroSection = () => {
	const { t } = useTranslation('common');
	const trustItems = [t('Verified dealers'), t('Credit & barter options'), t('9 cities')];

	return (
		// 'header-main' klassi HeaderFilter'ning mavjud dropdown stillarini ishlatish uchun qoldirildi
		<Stack component={'section'} className={'header-main hero-search hero-gallery'} aria-labelledby={'hero-title'}>
			<div className={'hero-intro'}>
				<h1 id={'hero-title'}>{t('hero_title')}</h1>
				<p className={'hero-sub'}>{t('hero_sub')}</p>
				<div className={'hero-actions'}>
					<Link href={'/car'} className={'hero-btn is-primary'}>
						{t('Search cars')}
					</Link>
					<Link href={'/dealer'} className={'hero-btn is-ghost'}>
						{t('Dealers')}
					</Link>
				</div>
				<ul className={'hero-trust'}>
					{trustItems.map((item) => (
						<li key={item}>
							<svg viewBox="0 0 16 16" width={16} height={16} aria-hidden="true">
								<path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
							</svg>
							{item}
						</li>
					))}
				</ul>
			</div>
			<FiberContainer />
			<span className={'gallery-hint'}>{t('Scroll to explore the gallery')}</span>
			<Stack className={'container'}>
				<HeaderFilter />
			</Stack>
		</Stack>
	);
};

export default HeroSection;
