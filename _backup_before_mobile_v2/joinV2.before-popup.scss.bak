/**
 * LOGIN / SIGN UP (pages/account/join.tsx) — desktop, V01 "Signal".
 * main.scss oxirida import qilinadi. Faqat .jn-v2 ichida ishlaydi, eski join.scss stillariga tegmaydi.
 * Mobil versiya: scss/mobile/mobileV2.scss (.m-join)
 */
$jn-ease: cubic-bezier(0.23, 1, 0.32, 1);
$jn-graphite: #14171c;
$jn-faint: #9aa0a8;

#pc-wrap .join-page.jn-v2 {
	display: block;
	padding: 48px 0 96px;
	background: $c-bg;
	font-family: $font;
	color: $c-text;

	.jn-wrap {
		width: min(1080px, calc(100% - 48px));
		margin: 0 auto;
	}
	.jn-card {
		min-height: 620px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		overflow: hidden;
		border: 1px solid $c-line;
		border-radius: $r-lg;
		background: $c-surface;
		box-shadow: 0 30px 60px -40px rgba(20, 23, 28, 0.35);
	}

	/* ---------- chap: ko'k brend paneli (rasm o'rniga) ---------- */
	.jn-visual {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		background: radial-gradient(120% 90% at 0% 0%, #2f76ff 0%, $c-primary 45%, #0043c7 100%);
		color: #ffffff;
	}
	.jn-pattern {
		position: absolute;
		right: -90px;
		bottom: -70px;
		width: 460px;
		height: 460px;
		fill: none;
		stroke: rgba(255, 255, 255, 0.1);
		stroke-width: 22;
		stroke-linecap: round;
		stroke-linejoin: round;
		pointer-events: none;
		circle {
			fill: rgba(255, 255, 255, 0.1);
			stroke: none;
		}
	}
	.jn-visual-content {
		position: relative;
		z-index: 1;
		width: 100%;
		padding: 44px 40px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 10px;
		h2 {
			margin: 14px 0 0;
			color: #ffffff;
			font-size: 34px;
			font-weight: 800;
			letter-spacing: -0.02em;
			line-height: 1.15;
		}
		p {
			margin: 0;
			color: #dce7ff;
			font-size: 15px;
		}
	}
	.jn-brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: #ffffff;
		font-size: 14px;
		font-weight: 800;
		letter-spacing: 0.18em;
	}

	// kichik e'lon kartasi (bezak)
	.jn-preview {
		margin: 22px 0 6px;
		max-width: 340px;
		padding: 10px;
		display: flex;
		align-items: center;
		gap: 14px;
		border-radius: 18px;
		background: #ffffff;
		color: $c-text;
		box-shadow: 0 24px 48px -24px rgba(0, 20, 80, 0.55);
		transform: rotate(-2deg);
	}
	.jn-preview-img {
		flex-shrink: 0;
		width: 120px;
		height: 84px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 12px;
		background: $c-surface-2;
		img {
			width: 112%;
			height: auto;
		}
	}
	.jn-preview-body {
		min-width: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 3px;
		strong {
			font-size: 15px;
			font-weight: 800;
		}
	}
	.jn-preview-meta {
		color: $c-muted;
		font-size: 12px;
	}
	.jn-preview-row {
		margin-top: 6px;
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.jn-preview-chip {
		height: 22px;
		padding: 0 8px;
		display: inline-flex;
		align-items: center;
		border-radius: 11px;
		background: #e9f7ef;
		color: #1e7e46;
		font-size: 11px;
		font-weight: 700;
	}
	.jn-preview-heart {
		margin-left: auto;
		display: inline-flex;
		svg {
			font-size: 20px;
			color: #e5484d;
		}
	}

	.jn-benefits {
		margin: 18px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
		li {
			display: flex;
			align-items: flex-start;
			gap: 10px;
			color: #eef3ff;
			font-size: 14px;
			line-height: 1.5;
		}
		svg {
			flex-shrink: 0;
			margin-top: 1px;
			width: 20px;
			height: 20px;
			padding: 3px;
			box-sizing: border-box;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.18);
			color: #ffffff;
		}
	}

	/* ---------- o'ng: forma ---------- */
	.jn-form {
		padding: 40px 48px;
		display: flex;
		flex-direction: column;
		h1 {
			margin: 28px 0 0;
			color: $c-text;
			font-size: 28px;
			font-weight: 800;
			letter-spacing: -0.02em;
		}
	}
	.jn-sub {
		margin: 6px 0 0;
		color: $c-muted;
		font-size: 15px;
	}
	.jn-tabs {
		align-self: flex-start;
		padding: 4px;
		display: inline-flex;
		gap: 4px;
		border: 1px solid $c-line;
		border-radius: 14px;
		background: $c-bg;
		button {
			height: 40px;
			padding: 0 22px;
			border: none;
			border-radius: 10px;
			background: transparent;
			color: $c-muted;
			font-family: $font;
			font-size: 14px;
			font-weight: 700;
			cursor: pointer;
			transition: background-color 160ms ease, color 160ms ease;
			&:hover {
				color: $c-text;
			}
			&.is-active {
				background: $jn-graphite;
				color: #ffffff;
			}
			&:focus-visible {
				outline: 2px solid $c-primary;
				outline-offset: 2px;
			}
		}
	}

	.jn-fields {
		margin-top: 24px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.jn-field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		> span:first-child {
			color: $c-text;
			font-size: 13px;
			font-weight: 700;
		}
	}
	.jn-input {
		height: 50px;
		padding: 0 6px 0 14px;
		display: flex;
		align-items: center;
		gap: 10px;
		box-sizing: border-box;
		border: 1px solid $c-line;
		border-radius: 12px;
		background: $c-bg;
		transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
		> svg {
			flex-shrink: 0;
			font-size: 20px;
			color: $c-muted;
		}
		input {
			flex: 1;
			min-width: 0;
			height: 100%;
			padding: 0;
			border: none;
			outline: none;
			background: transparent;
			color: $c-text;
			font-family: $font;
			font-size: 15px;
			&::placeholder {
				color: $jn-faint;
			}
		}
		&:hover {
			border-color: #cfd2d9;
		}
		&:focus-within {
			border-color: $c-primary;
			background: $c-surface;
			box-shadow: 0 0 0 4px rgba(0, 87, 255, 0.12);
			> svg {
				color: $c-primary;
			}
		}
	}
	.jn-eye {
		width: 38px;
		height: 38px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: 10px;
		background: transparent;
		color: $c-muted;
		cursor: pointer;
		svg {
			font-size: 20px;
		}
		&:hover {
			background: $c-surface-2;
			color: $c-text;
		}
	}

	.jn-types {
		margin-top: 18px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.jn-types-label {
		color: $c-text;
		font-size: 13px;
		font-weight: 700;
	}
	.jn-types-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}
	.jn-type {
		position: relative;
		padding: 14px;
		display: flex;
		align-items: flex-start;
		gap: 10px;
		border: 1px solid $c-line;
		border-radius: 14px;
		background: $c-surface;
		color: $c-text;
		font-family: $font;
		text-align: left;
		cursor: pointer;
		transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
		> span:not(.jn-radio) {
			display: flex;
			flex-direction: column;
			gap: 2px;
		}
		strong {
			font-size: 14px;
			font-weight: 800;
		}
		small {
			color: $c-muted;
			font-size: 12px;
			line-height: 1.4;
		}
		.jn-type-icon {
			flex-shrink: 0;
			font-size: 22px;
			color: $c-muted;
		}
		&:hover {
			border-color: $c-muted;
		}
		&.is-active {
			border-color: $c-primary;
			background: rgba(0, 87, 255, 0.05);
			box-shadow: 0 0 0 3px rgba(0, 87, 255, 0.1);
			.jn-type-icon {
				color: $c-primary;
			}
			.jn-radio {
				border-color: $c-primary;
				&::after {
					transform: scale(1);
				}
			}
		}
		&:focus-visible {
			outline: 2px solid $c-primary;
			outline-offset: 2px;
		}
	}
	.jn-radio {
		position: absolute;
		top: 12px;
		right: 12px;
		width: 18px;
		height: 18px;
		box-sizing: border-box;
		border: 2px solid #c4c7cf;
		border-radius: 50%;
		&::after {
			content: '';
			position: absolute;
			inset: 3px;
			border-radius: 50%;
			background: $c-primary;
			transform: scale(0);
			transition: transform 180ms $jn-ease;
		}
	}

	.jn-remember {
		margin-top: 12px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		.MuiFormControlLabel-label {
			color: $c-text;
			font-family: $font;
			font-size: 14px;
		}
		.MuiCheckbox-root.Mui-checked {
			color: $c-primary;
		}
		a {
			color: $c-primary-dark;
			font-size: 14px;
			font-weight: 700;
			cursor: pointer;
			&:hover {
				text-decoration: underline;
			}
		}
	}

	.jn-submit {
		margin-top: 22px;
		height: 52px;
		gap: 8px;
		border-radius: 14px;
		background: $c-primary;
		color: #ffffff;
		font-family: $font;
		font-size: 15px;
		font-weight: 800;
		text-transform: none;
		transition: background-color 160ms ease, box-shadow 200ms $jn-ease, transform 120ms $jn-ease;
		.MuiButton-endIcon {
			margin: 0;
			transition: transform 200ms $jn-ease;
		}
		&:hover {
			background: $c-primary-dark;
			box-shadow: 0 14px 28px -14px rgba(0, 87, 255, 0.6);
			.MuiButton-endIcon {
				transform: translateX(3px);
			}
		}
		&:active {
			transform: scale(0.98);
		}
		&.Mui-disabled {
			background: $c-primary;
			color: #ffffff;
			opacity: 0.4;
			box-shadow: none;
		}
	}
	.jn-switch {
		margin: 18px 0 0;
		color: $c-muted;
		font-size: 14px;
		text-align: center;
		button {
			padding: 0;
			border: none;
			background: none;
			color: $c-primary-dark;
			font-family: $font;
			font-size: 14px;
			font-weight: 800;
			cursor: pointer;
			&:hover {
				text-decoration: underline;
			}
		}
	}

	@media (max-width: 900px) {
		.jn-card {
			grid-template-columns: minmax(0, 1fr);
		}
		.jn-visual {
			min-height: 0;
		}
		.jn-preview {
			display: none;
		}
		.jn-form {
			padding: 32px 24px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.jn-submit,
		.jn-submit .MuiButton-endIcon,
		.jn-radio::after {
			transition: none;
		}
	}
}
