// enum qiymatini o'qiladigan ko'rinishga keltiradi: SEOUL → Seoul, KIA → Kia, GASOLINE → Gasoline
// (qisqartmalar — SUV, KGM, BMW, LPG — o'zgarmaydi)
const ENUM_ACRONYMS = ['SUV', 'KGM', 'BMW', 'LPG'];
export const formatEnum = (value?: string): string => {
	if (!value) return '';
	if (ENUM_ACRONYMS.includes(value)) return value;
	return value.charAt(0) + value.slice(1).toLowerCase();
};

// enum qiymatini chiroyli ko'rinishga keltiradi: 'SEOUL' → 'Seoul' (qisqartmalar o'zgarmaydi: BMW, SUV...)
const KEEP_UPPER = ['BMW', 'KGM', 'SUV', 'LPG'];
export const prettyLabel = (value: string = ''): string =>
	KEEP_UPPER.includes(value) ? value : value.charAt(0) + value.slice(1).toLowerCase();
