/**
 * AUTORE — V01 "SIGNAL" DIZAYN QATLAMI
 * Signal Blue (#0057FF) + Porcelain (#F8F7F4) + Graphite (#23262F)
 * Bu fayl main.scss'ning oxirida import qilinadi va mavjud stillar ustidan
 * faqat ko'rinishni o'zgartiradi (mantiq va komponent tuzilishi o'zgarmagan).
 */

body {
	background: $c-bg;
	color: $c-text;
	font-family: $font;
}

/* ---------- LOGO ---------- */
.autore-logo {
	// premium hover: faqat harakat — fon, soya yoki rang effekti yo'q
	$ease-out: cubic-bezier(0.22, 1, 0.36, 1); // easeOutQuint — yumshoq to'xtash
	$ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);

	display: inline-flex;
	align-items: center;
	gap: 10px;
	cursor: pointer;
	.autore-logo-mark {
		overflow: visible;
		transition: transform 300ms $ease-out;
	}
	.autore-logo-chevron {
		stroke-dasharray: 28;
		stroke-dashoffset: 0;
	}
	.autore-logo-dot {
		transform-box: fill-box;
		transform-origin: center;
	}
	.autore-logo-text {
		font-family: $font;
		font-size: 20px;
		font-weight: 800;
		letter-spacing: 0.14em;
		color: $c-text;
		span {
			display: inline-block;
		}
	}
	&.dark .autore-logo-text {
		color: #ffffff;
	}

	/* ---------- HOVER (faqat sichqoncha bor qurilmalarda) ---------- */
	@media (hover: hover) and (pointer: fine) {
		&:hover {
			.autore-logo-mark {
				transform: translateY(-1px);
			}
			.autore-logo-chevron {
				animation: autore-chevron-draw 350ms $ease-in-out;
			}
			.autore-logo-dot {
				animation: autore-dot-settle 300ms $ease-out 300ms backwards;
			}
			.autore-logo-text span {
				// harflar chapdan o'ngga navbat bilan ko'tarilib tushadi
				animation: autore-letter-rise 350ms $ease-out calc(var(--i) * 30ms);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.autore-logo-mark {
			transition: none;
		}
		&:hover {
			.autore-logo-mark {
				transform: none;
			}
			.autore-logo-chevron,
			.autore-logo-dot,
			.autore-logo-text span {
				animation: none;
			}
		}
	}
}

@keyframes autore-chevron-draw {
	from {
		stroke-dashoffset: 28;
	}
	to {
		stroke-dashoffset: 0;
	}
}

@keyframes autore-dot-settle {
	from {
		opacity: 0;
		transform: scale(0.3);
	}
	to {
		opacity: 1;
		transform: scale(1);
	}
}

@keyframes autore-letter-rise {
	0% {
		transform: translateY(0);
	}
	40% {
		transform: translateY(-2px);
	}
	100% {
		transform: translateY(0);
	}
}

#pc-wrap {
	/* ---------- NAVBAR ---------- */
	// harakat egri chizig'i: kuchli ease-out (Emil Kowalski) — UI kirish/chiqish uchun
	$ease-ui: cubic-bezier(0.23, 1, 0.32, 1);

	#top .navbar .navbar-main {
		background: rgba(248, 247, 244, 0.92);
		backdrop-filter: blur(12px);
		border-top: none;
		border-bottom: 1px solid $c-line;
		// rang o'zgarishi silliq; backdrop-filter animatsiya qilinmaydi (darhol almashadi)
		transition: background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
		&.transparent {
			background: rgba(248, 247, 244, 0.97);
			box-shadow: 0 6px 24px rgba(35, 38, 47, 0.06);
		}
		.container {
			// 1300px'dan tor ekranlarda chetlarga yopishmasin (faqat navbar uchun)
			width: min(1300px, calc(100% - 48px));
			gap: 32px;
			.logo-box {
				display: flex;
				align-items: center;
				a {
					display: inline-flex;
					border-radius: $r-sm;
				}
			}
			// qat'iy kengliklar o'rniga gap — uzun (ruscha) yozuvlar sig'adi
			.router-box {
				width: auto;
				flex: 1;
				justify-content: center;
				gap: 36px;
				.nav-link {
					position: relative;
					padding: 6px 0;
					color: $c-muted;
					font-family: $font;
					font-size: 15px;
					font-weight: 600;
					white-space: nowrap;
					transition: color 150ms ease;
					// joriy sahifa: pastdan ingichka chiziq (chapdan o'sib chiqadi)
					&::after {
						content: '';
						position: absolute;
						left: 0;
						right: 0;
						bottom: 0;
						height: 2px;
						border-radius: 2px;
						background: $c-primary;
						transform: scaleX(0);
						transform-origin: left center;
						transition: transform 200ms $ease-ui;
					}
					&.active {
						color: $c-text;
						&::after {
							transform: scaleX(1);
						}
					}
				}
			}
			.user-box {
				width: auto;
				gap: 4px;
				.join-box {
					// ikkinchi darajali tugma — sahifadagi yagona asosiy tugma "Search cars"
					width: auto;
					height: 44px;
					padding: 0 18px;
					gap: 8px;
					border: 1px solid $c-line;
					border-radius: 999px;
					background: transparent;
					transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease,
						transform 160ms $ease-ui;
					svg {
						margin-right: 0;
						color: $c-text;
					}
					span {
						color: $c-text;
						font-weight: 700;
					}
					&:active {
						transform: scale(0.97);
					}
				}
				.login-user {
					padding: 0;
					border: 0;
					border-radius: 50%;
					background: none;
					cursor: pointer;
					transition: transform 160ms $ease-ui;
					&:active {
						transform: scale(0.97);
					}
					img {
						display: block;
					}
				}
			}
			.lan-box .lang-caret {
				color: $c-muted;
			}
			a:focus-visible,
			button:focus-visible {
				outline: 2px solid $c-primary;
				outline-offset: 3px;
			}
		}

		// bosh sahifa: hero rasmi ustida shaffof, oq yozuvlar (skroll qilinganda oddiy holatga qaytadi)
		&.on-hero {
			background: transparent;
			backdrop-filter: none;
			border-bottom-color: transparent;
			box-shadow: none;
			.container {
				.router-box .nav-link {
					color: rgba(255, 255, 255, 0.82);
					&::after {
						background: #ffffff;
					}
					&.active {
						color: #ffffff;
					}
				}
				.user-box .join-box {
					border-color: rgba(255, 255, 255, 0.55);
					svg,
					span {
						color: #ffffff;
					}
				}
				.lan-box .lang-caret {
					color: #ffffff;
				}
				a:focus-visible,
				button:focus-visible {
					outline-color: #ffffff;
				}
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.container .router-box .nav-link::after {
				transition: none;
			}
			.container .user-box .join-box:active,
			.container .user-box .login-user:active {
				transform: none;
			}
		}

		@media (hover: hover) and (pointer: fine) {
			.container .router-box .nav-link:hover {
				color: $c-text;
			}
			.container .user-box .join-box:hover {
				border-color: $c-text;
			}
			&.on-hero .container .router-box .nav-link:hover {
				color: #ffffff;
			}
			&.on-hero .container .user-box .join-box:hover {
				border-color: #ffffff;
				background: rgba(255, 255, 255, 0.08);
			}
		}
	}

	/* ICHKI SAHIFALAR SARLAVHASI (LayoutBasic .header-basic): nestar-next bilan bir xil — pc/main.scss'dagi asl stil ishlatiladi.
	   Faqat yengil soya: oq yozuv yorug' mashina rasmlari ustida ham o'qilishi uchun */
	.header-basic .container {
		strong,
		span {
			text-shadow: 0 2px 14px rgba(0, 0, 0, 0.65), 0 1px 3px rgba(0, 0, 0, 0.5);
		}
	}

	/* kartalar: V01 klassik karta — oq fon, yupqa chegara, 16px burchak */
	.popular-card-box,
	.top-card-box,
	.car-card-box,
	.car-big-card-box {
		.card-img {
			border-radius: $r-md $r-md 0 0;
			background-color: $c-surface-2;
		}
		.info {
			border-color: $c-line;
			border-radius: 0 0 $r-md $r-md;
			box-shadow: none;
		}
	}

	/* /car ro'yxatidagi karta: yil · probeg · yoqilg'i bir qatorda */
	.card-config .bottom .options {
		gap: 12px;
		.option p {
			white-space: nowrap;
			font-size: 13px;
		}
	}

	/* ---------- FOOTER ---------- */
	#footer .footer-container .main .left .footer-box {
		.logo {
			width: auto;
			height: auto;
		}
		.autore-logo .autore-logo-text {
			color: #ffffff;
			font-size: 20px;
			font-weight: 800;
			text-transform: none;
		}
	}
}

/* MUI tugmalari va kirish maydonlari uchun umumiy burchak */
.MuiButton-root {
	font-family: $font !important;
	text-transform: none !important;
}

/* hisob menyusidagi "Logout" ikonkasi (MUI Menu portal'da — #pc-wrap tashqarisida) */
.logout-icon {
	margin-right: 10px;
	color: $c-primary;
}
