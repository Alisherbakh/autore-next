/**
 * MASHINA SAHIFASI (pages/car/detail.tsx) — premium dizayn (galereya + yopishqoq narx/dealer paneli).
 * main.scss oxirida import qilinadi. Faqat .cd-v2 ichida ishlaydi, eski detail.scss stillariga tegmaydi.
 */
$cd-ease: cubic-bezier(0.23, 1, 0.32, 1);
$cd-graphite: #14171c;
$cd-muted: #6b7079;

#pc-wrap #car-detail-page.cd-v2,
#car-detail-page.cd-v2 {
	width: 100%;
	padding-bottom: 0; // eski detail.scss'dagi 200px o'rniga (padding-top: 87px — fixed navbar uchun — qoladi)
	background: $c-bg;
	font-family: $font;
	color: $c-text;

	.cd-wrap {
		width: min(1300px, calc(100% - 48px));
		margin: 0 auto;
		padding: 24px 0 96px;
	}
	.cd-muted {
		color: $cd-muted;
		font-size: 14px;
	}
	.cd-link {
		color: $c-primary-dark;
		font-size: 14px;
		font-weight: 700;
	}

	/* breadcrumb */
	.cd-crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: $cd-muted;
		a {
			color: $cd-muted;
		}
		strong {
			color: $c-text;
			font-weight: 600;
		}
	}

	/* galereya */
	.cd-gallery {
		position: relative;
		margin-top: 16px;
		height: clamp(340px, 46vw, 600px);
		display: grid;
		gap: 8px;
		border-radius: 24px;
		overflow: hidden;
	}
	.cd-tile {
		padding: 0;
		border: 0;
		overflow: hidden;
		background: #e6e4de;
		cursor: zoom-in;
		&.is-main {
			grid-row: 1 / -1;
		}
		&.is-empty {
			display: flex;
			align-items: center;
			justify-content: center;
			color: $cd-muted;
			cursor: default;
		}
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 500ms $cd-ease;
		}
		&:focus-visible {
			outline: 3px solid $c-primary;
			outline-offset: -3px;
		}
	}
	.cd-photo-count {
		position: absolute;
		left: 16px;
		bottom: 16px;
		height: 32px;
		padding: 0 12px;
		border-radius: 16px;
		background: rgba(20, 23, 28, 0.72);
		color: #ffffff;
		display: inline-flex;
		align-items: center;
		font-size: 13px;
		font-weight: 700;
	}
	.cd-all-photos {
		position: absolute;
		right: 16px;
		bottom: 16px;
		height: 40px;
		padding: 0 16px;
		border: 0;
		border-radius: 20px;
		background: #ffffff;
		color: $c-text;
		font-size: 14px;
		font-weight: 700;
	}

	/* tugmalar: hover'da biroz ko'tariladi, bosilganda "botadi" */
	.cd-btn {
		cursor: pointer;
		font-family: $font;
		transition: background-color 160ms ease, transform 120ms $cd-ease, box-shadow 160ms ease;
		&:active {
			transform: scale(0.97);
			box-shadow: none;
		}
		&:focus-visible {
			outline: 2px solid $c-primary;
			outline-offset: 2px;
		}
		&:disabled {
			opacity: 0.45;
			cursor: not-allowed;
			transform: none;
		}
	}
	.cd-dark {
		border: 0;
		background: $cd-graphite;
		color: #ffffff;
	}

	/* ikki ustun */
	.cd-columns {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 40px;
	}
	.cd-main {
		flex: 999 1 560px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	.cd-tag {
		display: inline-flex;
		align-items: center;
		height: 26px;
		padding: 0 10px;
		border-radius: 13px;
		background: #e8eeff;
		color: $c-primary-dark;
		font-size: 12px;
		font-weight: 700;
	}
	.cd-head h1 {
		margin: 12px 0 0;
		font-size: clamp(30px, 3vw, 42px);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.cd-like {
		height: 38px;
		margin: -6px 0;
		padding: 0 12px 0 10px;
		border: 0;
		border-radius: 16px;
		background: transparent;
		color: #4a4f57;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: $font;
		font-size: 16px;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 160ms ease, transform 120ms $cd-ease;
		svg {
			font-size: 22px;
			transition: transform 160ms $cd-ease;
		}
		&.is-liked {
			color: $c-text;
			font-weight: 700;
		}
		&:active {
			transform: scale(0.95);
		}
		&:focus-visible {
			outline: 2px solid $c-primary;
			outline-offset: 2px;
		}
		@media (hover: hover) and (pointer: fine) {
			&:hover {
				background: #efede8;
				svg {
					transform: scale(1.15);
				}
			}
		}
		@media (prefers-reduced-motion: reduce) {
			transition: none;
			svg {
				transition: none;
			}
			&:active,
			&:hover svg {
				transform: none;
			}
		}
	}
	.cd-meta {
		margin-top: 14px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 24px;
		color: #4a4f57; // oldingidan to'qroq — o'qish oson
		font-size: 16px;
		font-weight: 500;
		span {
			display: inline-flex;
			align-items: center;
			gap: 6px;
		}
		svg {
			font-size: 20px;
		}
	}

	.cd-specs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 12px;
	}
	.cd-spec {
		padding: 16px 18px;
		border: 1px solid $c-line;
		border-radius: 16px;
		background: #ffffff;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.cd-spec-icon {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: $c-surface-2;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.cd-spec-label {
		color: $cd-muted;
		font-size: 12px;
		font-weight: 600;
	}
	.cd-spec-value {
		font-size: 16px;
		font-weight: 700;
	}

	.cd-section h2,
	.cd-similar h2 {
		margin: 0;
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.cd-section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
		p {
			margin: 6px 0 0;
		}
	}
	.cd-desc {
		margin: 12px 0 0;
		max-width: 68ch;
		color: #4a4f57;
		font-size: 16px;
		line-height: 1.7;
		white-space: pre-line;
		&.is-empty {
			color: #9aa0a8;
			font-style: italic;
		}
	}
	.cd-details {
		margin: 16px 0 0;
		padding: 8px 24px;
		border: 1px solid $c-line;
		border-radius: 16px;
		background: #ffffff;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		column-gap: 32px;
		> div {
			padding: 14px 0;
			border-bottom: 1px solid #efede8;
			display: flex;
			justify-content: space-between;
			gap: 16px;
		}
		dt {
			color: $cd-muted;
			font-size: 14px;
		}
		dd {
			margin: 0;
			text-align: right;
			font-size: 14px;
			font-weight: 700;
		}
	}
	.cd-map {
		margin-top: 16px;
		height: 300px;
		overflow: hidden;
		border: 1px solid $c-line;
		border-radius: 16px;
		background: #f3f1ec;
	}

	.cd-review-list {
		margin-top: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		.pagination-box {
			margin-top: 8px;
			display: flex;
			justify-content: center;
		}
		// Review.tsx kartasi — eski stillar faqat eski sahifa klasslari ichida edi, shuning uchun bu yerda qayta beriladi
		.review-config {
			padding: 20px 24px;
			border: 1px solid $c-line;
			border-radius: 16px;
			background: #ffffff;
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		.img-name-box {
			flex-direction: row;
			align-items: center;
			gap: 12px;
		}
		.img-box {
			flex-shrink: 0;
			width: 44px;
			height: 44px;
			border-radius: 50%;
			object-fit: cover;
			background: $c-surface-2;
		}
		.name {
			width: fit-content;
			color: $c-text;
			font-family: $font;
			font-size: 15px;
			font-weight: 700;
			cursor: pointer;
			&:hover {
				color: $c-primary-dark;
				text-decoration: underline;
			}
		}
		.date {
			color: $cd-muted;
			font-family: $font;
			font-size: 13px;
		}
		.description {
			color: #4a4f57;
			font-family: $font;
			font-size: 15px;
			line-height: 1.6;
			white-space: pre-line;
			word-break: break-word;
		}
	}
	.cd-review-form {
		margin-top: 16px;
		padding: 24px;
		border: 1px solid $c-line;
		border-radius: 16px;
		background: #ffffff;
		display: flex;
		flex-direction: column;
		gap: 12px;
		label {
			font-size: 14px;
			font-weight: 700;
		}
		textarea {
			padding: 14px 16px;
			border: 1px solid #dad8d1;
			border-radius: 12px;
			background: #fbfaf8;
			font-family: $font;
			font-size: 15px;
			resize: vertical;
			&:focus {
				outline: 2px solid $c-primary;
				outline-offset: 1px;
			}
		}
	}
	.cd-submit {
		align-self: flex-start;
		height: 44px;
		padding: 0 22px;
		border-radius: 12px;
		font-size: 14px;
		font-weight: 700;
	}

	/* o'ng panel */
	.cd-side {
		flex: 1 1 340px;
		max-width: 420px;
		position: sticky;
		top: 24px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.cd-panel {
		padding: 24px;
		border: 1px solid $c-line;
		border-radius: 20px;
		background: #ffffff;
		box-shadow: 0 24px 50px -36px rgba(20, 23, 28, 0.35);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.cd-price {
		margin-top: 4px;
		font-size: 36px;
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.cd-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.cd-badge {
		height: 30px;
		padding: 0 12px;
		border-radius: 15px;
		background: #f1f0ec;
		color: $cd-muted;
		display: inline-flex;
		align-items: center;
		font-size: 13px;
		font-weight: 600;
		&.is-on {
			background: #e7f5ee;
			color: #0f6b3e;
			font-weight: 700;
		}
		&.is-reserved {
			background: #f57c00;
			color: #ffffff;
			font-weight: 700;
		}
	}
	.cd-divider {
		height: 1px;
		background: #efede8;
	}
	.cd-dealer {
		display: flex;
		align-items: center;
		gap: 14px;
		img,
		.cd-dealer-initials {
			flex-shrink: 0;
			width: 56px;
			height: 56px;
			border-radius: 28px;
			object-fit: cover;
		}
		.cd-dealer-initials {
			background: linear-gradient(160deg, #e8eeff, #c9d6ff);
			color: $c-primary;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 18px;
			font-weight: 800;
		}
		> div {
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: 4px;
		}
		strong {
			overflow: hidden;
			font-size: 16px;
			white-space: nowrap;
			text-overflow: ellipsis;
		}
		> div > span {
			display: flex;
			align-items: center;
			gap: 8px;
			color: $cd-muted;
			font-size: 13px;
		}
	}
	.cd-dealer-badge {
		height: 22px;
		padding: 0 9px;
		border-radius: 11px;
		background: $cd-graphite;
		color: #ffffff;
		display: inline-flex;
		align-items: center;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.cd-actions {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.cd-action {
		height: 50px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		font-size: 15px;
		font-weight: 700;
		svg {
			font-size: 20px;
		}
	}
	.cd-note {
		padding: 16px 20px;
		border: 1px solid $c-line;
		border-radius: 16px;
		background: #ffffff;
		color: $cd-muted;
		font-size: 13px;
	}

	/* o'xshash mashinalar */
	.cd-similar {
		margin-top: 80px;
	}
	.cd-similar-grid {
		margin-top: 24px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 20px;
		> * {
			width: auto !important;
			min-width: 0;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.cd-tile:not(.is-empty):hover img {
			transform: scale(1.04);
		}
		.cd-btn:not(:disabled):hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 22px -12px rgba(0, 0, 0, 0.45);
		}
		.cd-btn:not(:disabled):active {
			transform: scale(0.97);
			box-shadow: none;
		}
		.cd-dark:not(:disabled):hover {
			background: #2c313a;
		}
		.cd-all-photos:hover {
			background: #f1f0ec;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cd-btn,
		.cd-tile img {
			transition: none;
		}
		.cd-btn:hover,
		.cd-btn:active {
			transform: none;
		}
	}
	@media (max-width: 900px) {
		.cd-side {
			position: static;
			max-width: none;
		}
	}
}

/* to'liq ekranli rasm ko'ruvchi (MUI Dialog — #pc-wrap tashqarisida chiziladi) */
.MuiDialog-paper.cd-viewer {
	background: rgba(12, 13, 16, 0.96);
	color: #ffffff;
	font-family: $font;
	display: flex;
	flex-direction: column;

	.cd-viewer-top {
		padding: 16px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		font-size: 14px;
		font-weight: 700;
		strong {
			overflow: hidden;
			font-size: 15px;
			white-space: nowrap;
			text-overflow: ellipsis;
		}
	}
	.cd-round {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 24px;
		background: transparent;
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background-color 160ms ease;
		&:hover {
			background: rgba(255, 255, 255, 0.12);
		}
		&:focus-visible {
			outline: 2px solid #ffffff;
			outline-offset: 2px;
		}
	}
	.cd-viewer-stage {
		flex: 1;
		min-height: 0;
		padding: 0 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
	}
	// hamma rasm bir xil katta ramkada ko'rinadi
	.cd-viewer-frame {
		flex: 1 1 auto;
		min-width: 0;
		max-width: 1100px;
		height: 100%;
		max-height: 680px;
		display: flex;
		align-items: center;
		justify-content: center;
		img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			border-radius: 12px;
		}
	}
	.cd-viewer-thumbs {
		padding: 16px 24px 24px;
		display: flex;
		justify-content: center;
		gap: 8px;
		overflow-x: auto;
		button {
			flex-shrink: 0;
			width: 88px;
			height: 60px;
			padding: 0;
			overflow: hidden;
			border: 2px solid transparent;
			border-radius: 8px;
			background: none;
			opacity: 0.55;
			cursor: pointer;
			&.is-active {
				border-color: #ffffff;
				opacity: 1;
			}
		}
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
	}
}
