/**
 * MOBIL: Community ro'yxati va maqola sahifasi — V01 "Signal".
 * scss/mobile/main.scss oxirida import qilinadi. Desktop: scss/pc/community/communityV2.scss
 * (CommunityCard va tahrirlash oynasi stillari global — desktop faylida)
 */
$cmm-body: #3b414a;
$cmm-faint: #9aa0a8;

#mobile-wrap {
	#community-list-page.cm-mobile,
	#community-detail-page.cm-mobile {
		width: 100%;
		padding: 20px 16px 48px;
		box-sizing: border-box;
		background: $c-bg;
		font-family: $font;
		color: $c-text;

		.cm-head {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 12px;
			.cm-title {
				font-size: 28px;
				font-weight: 800;
				letter-spacing: -0.02em;
			}
			.cm-sub {
				margin-top: 6px;
				color: $c-muted;
				font-size: 14px;
				line-height: 1.45;
			}
		}
		.cm-btn-primary {
			height: 42px;
			padding: 0 14px;
			gap: 6px;
			border-radius: 12px;
			background: $c-primary;
			color: #ffffff;
			font-family: $font;
			font-size: 14px;
			font-weight: 700;
			text-transform: none;
			.MuiButton-startIcon {
				margin: 0;
			}
			&.Mui-disabled {
				color: #ffffff;
				opacity: 0.4;
			}
		}
		.cm-write-sm {
			flex-shrink: 0;
		}

		// kategoriyalar — gorizontal aylantiriladigan chip'lar
		.cm-tabs {
			min-height: 0;
			margin: 18px -16px 0;
			.MuiTabs-scroller {
				padding: 0 16px;
			}
			.MuiTabs-flexContainer {
				gap: 8px;
			}
			.tab-button {
				min-height: 40px;
				min-width: 0;
				padding: 0 14px;
				gap: 6px;
				border: 1px solid $c-line;
				border-radius: 20px;
				background: $c-surface;
				color: $c-muted;
				font-family: $font;
				font-size: 14px;
				font-weight: 700;
				text-transform: none;
				opacity: 1;
				.MuiTab-iconWrapper {
					margin: 0;
					font-size: 18px;
				}
				&.active,
				&.Mui-selected {
					border-color: $c-primary;
					background: $c-primary;
					color: #ffffff;
				}
			}
		}

		.cm-panel {
			padding: 16px 0 0;
		}
		.cm-grid {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
			@media (min-width: 560px) {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
		.cm-empty {
			grid-column: 1 / -1;
			padding: 44px 20px;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 8px;
			border: 1px dashed $c-line;
			border-radius: $r-md;
			background: $c-surface;
			text-align: center;
			.cm-empty-icon {
				width: 48px;
				height: 48px;
				margin-bottom: 4px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border-radius: 14px;
				background: rgba(0, 87, 255, 0.08);
				color: $c-primary;
			}
			strong {
				font-size: 17px;
				font-weight: 800;
			}
			p {
				color: $c-muted;
				font-size: 14px;
			}
			.cm-btn-primary {
				margin-top: 8px;
			}
		}
		.cm-pagination {
			margin-top: 24px;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 10px;
			.cm-total {
				color: $c-muted;
				font-family: $font;
				font-size: 13px;
			}
		}
	}

	/* ---------- maqola sahifasi (mobil) ---------- */
	#community-detail-page.cm-mobile {
		padding-top: 4px;
		.cm-tabs {
			margin-top: 12px;
			margin-bottom: 16px;
		}
		.cm-article,
		.cm-comments {
			overflow: hidden;
			border: 1px solid $c-line;
			border-radius: $r-md;
			background: $c-surface;
		}
		.cm-article-cover img {
			width: 100%;
			max-height: 240px;
			display: block;
			object-fit: cover;
		}
		.cm-article-head {
			padding: 20px 18px 0;
		}
		.cm-chip {
			height: 28px;
			padding: 0 11px;
			display: inline-flex;
			align-items: center;
			gap: 5px;
			border-radius: 14px;
			background: rgba(0, 87, 255, 0.08);
			color: $c-primary;
			font-size: 12px;
			font-weight: 800;
			svg {
				font-size: 16px;
			}
		}
		.cm-article-title {
			margin-top: 12px;
			font-family: $font;
			font-size: 24px;
			font-weight: 800;
			line-height: 1.25;
			letter-spacing: -0.02em;
			word-break: break-word;
		}
		.cm-article-meta {
			margin-top: 16px;
			padding-bottom: 16px;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
			border-bottom: 1px solid $c-line;
		}
		.cm-author {
			min-width: 0;
			display: flex;
			align-items: center;
			gap: 10px;
			img {
				flex-shrink: 0;
				width: 40px;
				height: 40px;
				border-radius: 50%;
				object-fit: cover;
				background: $c-surface-2;
			}
			> div {
				display: flex;
				flex-direction: column;
				gap: 2px;
			}
			strong {
				font-size: 14px;
				font-weight: 700;
			}
			.cm-time {
				color: $c-muted;
				font-size: 12px;
			}
		}
		.cm-article-stats {
			display: flex;
			gap: 16px;
			color: $c-muted;
			font-size: 13px;
			font-weight: 700;
			span {
				display: inline-flex;
				align-items: center;
				gap: 5px;
			}
			svg {
				font-size: 18px;
				color: #8a9099;
			}
		}
		.cm-article-body {
			padding: 18px 18px 4px;
			> .MuiStack-root {
				margin: 0 !important;
				background: transparent !important;
			}
			.MuiBox-root {
				margin: 0 !important;
			}
			.toastui-editor-contents {
				color: $cmm-body;
				font-family: $font;
				font-size: 15px;
				line-height: 1.7;
				img,
				iframe {
					max-width: 100%;
					border-radius: 10px;
				}
			}
		}
		.cm-article-foot {
			margin: 12px 18px 0;
			padding: 16px 0 18px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			border-top: 1px solid $c-line;
			p {
				color: $c-muted;
				font-size: 13px;
				font-weight: 600;
			}
		}
		.cm-like-btn {
			flex-shrink: 0;
			height: 44px;
			padding: 0 14px;
			gap: 6px;
			border: 1px solid $c-line;
			border-radius: 12px;
			color: $c-text;
			font-family: $font;
			font-size: 14px;
			font-weight: 700;
			.MuiButton-startIcon {
				margin: 0;
			}
			.cm-like-count {
				padding: 1px 7px;
				border-radius: 10px;
				background: $c-surface-2;
				font-size: 12px;
			}
			&.is-liked {
				border-color: $c-primary;
				background: rgba(0, 87, 255, 0.08);
				color: $c-primary;
				.cm-like-count {
					background: $c-primary;
					color: #ffffff;
				}
			}
		}

		.cm-comments {
			margin-top: 16px;
			padding: 18px 16px 14px;
		}
		.cm-comments-head {
			display: flex;
			align-items: center;
			gap: 8px;
			h2 {
				font-size: 19px;
				font-weight: 800;
			}
			.cm-count {
				height: 24px;
				padding: 0 10px;
				display: inline-flex;
				align-items: center;
				border-radius: 12px;
				background: $c-surface-2;
				font-size: 12px;
				font-weight: 800;
			}
		}
		.cm-comment-form {
			margin-top: 14px;
			padding: 10px;
			display: flex;
			flex-direction: column;
			gap: 8px;
			border: 1px solid $c-line;
			border-radius: 12px;
			background: $c-bg;
			input {
				height: 42px;
				padding: 0 4px;
				border: none;
				outline: none;
				background: transparent;
				color: $c-text;
				font-family: $font;
				font-size: 16px;
				&::placeholder {
					color: $cmm-faint;
				}
			}
			&:focus-within {
				border-color: $c-primary;
			}
		}
		.cm-comment-actions {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.cm-counter {
			color: $cmm-faint;
			font-family: $font;
			font-size: 12px;
			&.is-near {
				color: $c-accent;
			}
		}
		.cm-empty-sm {
			margin-top: 14px;
			padding: 26px 16px;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 6px;
			text-align: center;
			svg {
				font-size: 28px;
				color: $cmm-faint;
			}
			p {
				color: $c-muted;
				font-size: 14px;
			}
		}
		.cm-comment {
			padding: 14px 0;
			border-bottom: 1px solid $c-line;
			&:last-child {
				border-bottom: none;
			}
		}
		.cm-comment-top {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
			.cm-author img {
				width: 34px;
				height: 34px;
			}
		}
		.cm-comment-tools {
			display: flex;
			.MuiIconButton-root {
				padding: 8px;
				color: #8a9099;
				svg {
					font-size: 20px;
				}
			}
		}
		.cm-comment-text {
			margin-top: 8px;
			color: $cmm-body;
			font-family: $font;
			font-size: 14px;
			line-height: 1.55;
			word-break: break-word;
		}
		.cm-pagination {
			margin-top: 14px;
		}
	}
}
